---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import { HeroCarousel } from '../components/homepage/HeroCarousel';
import { MainContent } from '../components/homepage/MainContent';
import { PhoneIcon, MailIcon } from 'lucide-react';

const arrowIcon = '/img/modal-icons/arrow-right-icon.svg';
---

<Layout title="Cosmo Mapeamento">
  <section
    class="relative flex min-h-[min(100vh,1080px)] flex-col overflow-hidden"
  >
    <a
      class="absolute left-4 z-20 -translate-y-full bg-white px-4 py-2 text-primary-800 transition-transform duration-500 focus-visible:translate-y-0"
      href="#main-title"
    >
      Pular para o conteúdo
    </a>

    <header class="relative z-10 w-full shrink-0 bg-white shadow-lg">
      <div
        class="mx-auto flex max-w-screen-xl flex-col gap-4 px-4 py-4 sm:gap-6 sm:px-8 sm:py-6 md:px-16 md:py-8"
      >
        <div class="flex items-center justify-between gap-4">
          <h1 class="min-w-0 shrink">
            <a class="block" href="#">
              <img
                class="w-48 sm:w-64 md:w-80"
                src="/img/logo-banner.webp"
                alt="Cosmo Mapeamento"
              />
            </a>
          </h1>

          <div
            class="hidden flex-col gap-2 text-xs xs:flex sm:text-sm md:text-base"
          >
            <div class="flex items-center gap-2">
              <PhoneIcon className="h-4 w-4 shrink-0" />
              <a href="https://wa.me/message/YAJAA3RXTF7RG1">(31) 99897-9774</a>
            </div>
            <div class="flex items-center gap-2">
              <MailIcon className="h-4 w-4 shrink-0" />
              <a class="truncate" href="mailto:contato@cosmomapeamento.com.br">
                contato@cosmomapeamento.com.br
              </a>
            </div>
          </div>
        </div>

        <Navbar client:media="not all and (min-width: 768px)" />
      </div>
    </header>

    <div
      class="relative isolate flex min-h-0 flex-1 flex-col pb-[clamp(10rem,20vw,12rem)]"
    >
      <HeroCarousel client:load />

      <div
        class="z-10 mx-auto flex w-full max-w-screen-xl flex-1 flex-col justify-end px-6 sm:px-10 md:px-16"
      >
        <p
          id="main-title"
          class="max-w-3xl text-balance font-title text-2xl font-bold leading-snug text-white [text-shadow:0_0_1rem_black] sm:text-3xl md:text-4xl md:leading-tight"
        >
          Apoiamos projetos ambientais locais através de geotecnologias e
          informações espaciais precisas.
        </p>
      </div>

      <a
        class="absolute bottom-[min(2rem,2.5vw)] left-1/2 z-10 -translate-x-1/2"
        href="#services"
        title="Ir para a primeira seção"
      >
        <span class="sr-only">Ir para a primeira seção</span>
        <img
          class="w-[clamp(2rem,7vw,4rem)] rotate-90 invert"
          src={arrowIcon}
          alt=""
          width={64}
          height={64}
        />
      </a>
    </div>
  </section>

  <main>
    <MainContent client:load />
  </main>

  <footer
    class="no-collapse bg-white text-center text-sm font-semibold text-neutral-600"
  >
    <p>&copy; 2026 - COSMO MAPEAMENTO AMBIENTAL LTDA</p>
  </footer>
</Layout>
